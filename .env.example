# Cấu hình môi trường ứng dụng Thử Thách Tìm Kiếm - Tin học 11
# Cổng chạy ứng dụng (Mặc định 3000)
PORT=3000

# URL công khai ứng dụng khi triển khai (Dùng để sinh mã QR truy cập cho học sinh)
# Nếu không đặt, hệ thống sẽ tự động dò IP mạng LAN của máy giáo viên (VD: http://192.168.1.15:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cấu hình Supabase (Tùy chọn khi triển khai trên hạ tầng Supabase PostgreSQL & Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
